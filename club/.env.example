# No .env is required to start the local website with the settings.py defaults.
# PostgreSQL, Redis, and built frontend assets are still needed.
# Copy to repository-root .env and uncomment only the values you need.
# "optional" means optional for local website startup, not for the named feature.
# Do not keep a second club/.env: it takes precedence during Django loading.

# Local connection overrides: optional when your services match these defaults.
# Set the password if your database requires one. Compose supplies its own values.
# POSTGRES_DB=vas3k_club  # optional
# POSTGRES_USER=postgres  # optional
# POSTGRES_PASSWORD=  # optional
# POSTGRES_HOST=localhost  # optional
# POSTGRES_PORT=5432  # optional
# REDIS_HOST=localhost  # optional
# REDIS_PORT=6379  # optional
# REDIS_DB=0  # optional

# DEBUG=true  # optional
# APP_HOST=http://127.0.0.1:8000  # optional
# SECRET_KEY=  # optional

# Upload URL is currently defined in club/settings.py, not read from the env.
# MEDIA_UPLOAD_CODE=  # optional

# EMAIL_HOST=  # optional
# EMAIL_PORT=587  # optional
# EMAIL_HOST_USER=  # optional
# EMAIL_HOST_PASSWORD=  # optional
# DEFAULT_FROM_EMAIL=  # optional

# Club bot: optional for the website; real development credentials are required
# to run the bot. Do not substitute fake tokens.
# TELEGRAM_TOKEN=  # optional
# TELEGRAM_BOT_URL=  # optional
# TELEGRAM_ADMIN_CHAT_ID=  # optional
# TELEGRAM_CLUB_CHANNEL_URL=  # optional
# TELEGRAM_CLUB_CHANNEL_ID=  # optional
# TELEGRAM_CLUB_CHAT_ID=  # optional
# TELEGRAM_ONLINE_CHANNEL_URL=  # optional
# TELEGRAM_ONLINE_CHANNEL_ID=  # optional
# TELEGRAM_BOT_WEBHOOK_URL=  # optional
# TELEGRAM_API_ID=  # optional
# TELEGRAM_API_HASH=  # optional

# Helpdeskbot: optional for the website; its token and linked channel/group IDs
# are required to run this separate bot.
# TELEGRAM_HELP_DESK_BOT_TOKEN=  # optional
# TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_ID=  # optional
# TELEGRAM_HELP_DESK_BOT_QUESTION_CHANNEL_DISCUSSION_ID=  # optional
# TELEGRAM_HELP_DESK_BOT_WEBHOOK_URL=  # optional

# Other integrations: optional for startup. Features using missing credentials
# may fail when called; configure them only when you need to exercise them.
# SENTRY_DSN=  # optional
# OPENAI_API_KEY=  # optional
# STRIPE_API_KEY=  # optional
# STRIPE_PUBLIC_KEY=  # optional
# STRIPE_WEBHOOK_SECRET=  # optional
# STRIPE_TICKETS_API_KEY=  # optional
# STRIPE_TICKETS_WEBHOOK_SECRET=  # optional
# PATREON_CLIENT_ID=  # optional
# PATREON_CLIENT_SECRET=  # optional
# YOOKASSA_API_KEY=  # optional
# YOOKASSA_SHOP_ID=  # optional
# JWT_PRIVATE_KEY=  # optional
# WEBHOOK_SECRETS=  # optional
